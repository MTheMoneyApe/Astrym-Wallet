{
  "name": "@solanym/extension",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@solana/kit": "^2.3.0",
    "@solanym/wallet-core": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "copy:spp": "node scripts/copy-spp-assets.mjs",
    "copy:nym": "node scripts/copy-nym-mixfetch-assets.mjs",
    "smoke:nym": "node scripts/smoke-nym-mixfetch-assets.mjs",
    "smoke:nym:public": "node scripts/smoke-nym-mixfetch-assets.mjs --public",
    "smoke:spp": "node scripts/smoke-spp-assets.mjs",
    "smoke:spp:public": "node scripts/smoke-spp-assets.mjs --public",
    "build": "node scripts/copy-spp-assets.mjs && node scripts/copy-nym-mixfetch-assets.mjs && vite build --config vite.config.ts && vite build --config vite.background.config.ts && node scripts/smoke-spp-assets.mjs && node scripts/smoke-nym-mixfetch-assets.mjs --dist",
    "build:nym-dev": "node scripts/copy-nym-mixfetch-assets.mjs && vite build --config vite.config.ts && vite build --config vite.background.config.ts && node scripts/smoke-nym-mixfetch-assets.mjs --dist",
    "build:nym-live-smoke": "node scripts/build-nym-live-smoke.mjs",
    "build:spp-host": "vite build --config vite.spp-host.config.ts",
    "dev:webapp": "node scripts/copy-nym-mixfetch-assets.mjs && vite --config vite.webapp.config.ts --host",
    "build:webapp": "node scripts/copy-nym-mixfetch-assets.mjs && vite build --config vite.webapp.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "0.12.6",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.3"
  }
}
