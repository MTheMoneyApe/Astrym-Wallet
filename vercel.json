{
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "master": true
    }
  },
  "installCommand": "curl -sL https://github.com/MTheMoneyApe/Astrym-Wallet/releases/download/astrym-products-487228b73f06fba36ac71fef4523ec730d490cf5/astrym-vercel-products.tar.gz -o /tmp/a;sha256sum /tmp/a|grep 74c88dc360f2eb7c8132f7b495e05d72839c3a3408222ec53217b21e2736ed65",
  "buildCommand": "mkdir -p packages/extension/dist-webapp && tar xzf /tmp/a -C packages/extension/dist-webapp",
  "outputDirectory": "packages/extension/dist-webapp",
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/(.*)\\.zip",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/downloads/(.*)\\.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/webapp-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/downloads/astrym-wallet-mv3.zip",
      "destination": "https://github.com/MTheMoneyApe/Astrym-Wallet/releases/download/astrym-extension-downloads/astrym-wallet-mv3.zip"
    }
  ]
}
